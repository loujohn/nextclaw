# ── Git & misc ────────────────────────────────────────────
.git
.gitignore
*.md

# ── All node_modules (will be installed inside Docker) ────
**/node_modules

# ── Build artefacts (rebuilt inside Docker) ───────────────
**/.output
**/.nuxt
**/.next
**/dist

# ── Dev / test files ──────────────────────────────────────
**/*.test.ts
**/*.spec.ts
**/tests
**/__tests__

# ── Unneeded workspace packages ───────────────────────────
apps
workers
bridge
commands
docs
images
workspace
scripts

# Packages NOT needed to build nextclaw-digital-employee
packages/nextclaw
packages/nextclaw-server
packages/nextclaw-ui
packages/nextclaw-cli
packages/extensions/nextclaw-engine-plugin-codex-sdk
packages/extensions/nextclaw-engine-plugin-claude-agent-sdk

# ── Local env / secrets ───────────────────────────────────
.env
.env.local
.env.*.local

# ── Editor / OS ───────────────────────────────────────────
.DS_Store
.vscode
.idea
*.swp
