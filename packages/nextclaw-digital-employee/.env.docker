# ── Model & Provider (必填) ─────────────────────────────
NEXTCLAW_MODEL=dashscope/qwen3.5-plus
NEXTCLAW_PROVIDER_NAME=dashscope
NEXTCLAW_PROVIDER_API_KEY=sk-your-api-key-here
NEXTCLAW_PROVIDER_API_BASE=https://coding.dashscope.aliyuncs.com/v1

# ── DingTalk 组织同步 (可选) ────────────────────────────
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_CRON_EXPR=0 1 * * *
DINGTALK_SYNC_ENABLED=false

# ── 数据库 (可选, 默认 sqlite) ────────────────────────
# DB_CLIENT=sqlite             # sqlite | dm
# DB_HOST=localhost             # 达梦服务器地址
# DB_PORT=5236                  # 达梦端口
# DB_USER=SYSDBA                # 达梦用户名
# DB_PASSWORD=SYSDBA            # 达梦密码
# DB_SCHEMA=                    # 达梦 schema (可选)

# ── 服务端口 (可选, 默认 3000) ──────────────────────────
# PORT=3000
