# ── Model & Provider (必填) ─────────────────────────────
NEXTCLAW_MODEL=dashscope/qwen3.5-plus
NEXTCLAW_PROVIDER_NAME=dashscope
NEXTCLAW_PROVIDER_API_KEY=sk-your-api-key-here
NEXTCLAW_PROVIDER_API_BASE=https://coding.dashscope.aliyuncs.com/v1

# ── DingTalk 组织同步 (可选) ────────────────────────────
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_CRON_EXPR=0 1 * * *
DINGTALK_SYNC_ENABLED=false

# ── 人员同步 (可选) ─────────────────────────────────────
# PERSONNEL_SYNC_API_URL=https://shangji.cqdcg.com:10000/api/admin/project/workHour/listAllUsers
# PERSONNEL_SYNC_TOKEN_URL=https://shangji.cqdcg.com:10000/api/admin/oauth2/token
# PERSONNEL_SYNC_TOKEN_BASIC_AUTH=Basic your_base64_basic_auth
# PERSONNEL_SYNC_USERNAME=your_sync_username
# PERSONNEL_SYNC_PASSWORD=your_sync_password
# PERSONNEL_SYNC_LOGIN_TYPE=quick
# PERSONNEL_SYNC_GRANT_TYPE=password
# 如容器需通过代理访问外部服务，请配置：
# HTTPS_PROXY=http://host:port
# HTTP_PROXY=http://host:port
# NO_PROXY=localhost,127.0.0.1,::1,*.local
# 如目标接口使用内网自签名证书，仅临时排障时可启用：
# PERSONNEL_SYNC_SKIP_TLS_VERIFY=false

# ── 达梦数据库 (必填) ─────────────────────────────────
DB_HOST=localhost
DB_PORT=5236
DB_USER=SYSDBA
DB_PASSWORD=SYSDBA
# DB_SCHEMA=DIGITAL_EMPLOYEE

# ── 认证 (必填) ────────────────────────────────────────
JWT_SECRET=change-me-in-production

# 初始管理员密码 (仅首次启动时生效, 创建 admin@local 用户)
ADMIN_DEFAULT_PASSWORD=changeme123

# ── Keycloak SSO (可选, 留空则仅本地登录) ──────────────
# KEYCLOAK_URL=http://keycloak:8080
# KEYCLOAK_REALM=de-platform
# KEYCLOAK_CLIENT_ID=de-platform

# ── 服务端口 (可选, 默认 3000) ──────────────────────────
# PORT=3000
