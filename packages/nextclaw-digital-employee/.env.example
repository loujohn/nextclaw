NEXTCLAW_MODEL="dashscope/qwen3.5-plus"

# DingTalk org sync
DINGTALK_APP_KEY=your_app_key
DINGTALK_APP_SECRET=your_app_secret
DINGTALK_CRON_EXPR=0 1 * * *
DINGTALK_SYNC_ENABLED=false

# LLM provider
NEXTCLAW_PROVIDER_NAME="dashscope"
NEXTCLAW_PROVIDER_API_KEY=""
NEXTCLAW_PROVIDER_API_BASE="https://coding.dashscope.aliyuncs.com/v1"

# HTTP proxy (for container to access external LLM API)
# HTTPS_PROXY=http://host:port
# HTTP_PROXY=http://host:port
# NO_PROXY=localhost,127.0.0.1,::1,*.local

# Dameng DB (uncomment to use DM instead of default SQLite)
# DB_CLIENT=dm
# DB_HOST=your_dm_host
# DB_PORT=5239
# DB_USER=SYSDBA
# DB_PASSWORD=your_password
