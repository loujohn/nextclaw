NEXTCLAW_MODEL="dashscope/qwen3.5-plus"

# DingTalk org sync
DINGTALK_APP_KEY=your_app_key
DINGTALK_APP_SECRET=your_app_secret
DINGTALK_CRON_EXPR=0 1 * * *
DINGTALK_SYNC_ENABLED=false

# ── GitLab Code Review (optional) ─────────────────────────
GITLAB_URL=https://gitlab.your-company.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxx
GITLAB_WEBHOOK_TOKEN=your-secret-token
GITLAB_REVIEWER_EMPLOYEE_CODE=code-reviewer

# LLM provider
NEXTCLAW_PROVIDER_NAME="dashscope"
NEXTCLAW_PROVIDER_API_KEY=""
NEXTCLAW_PROVIDER_API_BASE="https://coding.dashscope.aliyuncs.com/v1"

# HTTP proxy (for container to access external LLM API)
# HTTPS_PROXY=http://host:port
# HTTP_PROXY=http://host:port
# NO_PROXY=localhost,127.0.0.1,::1,*.local

# ── 达梦数据库 (必填) ──────────────────────────────────
DB_HOST=your_dm_host
DB_PORT=5236
DB_USER=SYSDBA
DB_PASSWORD=your_password
# DB_SCHEMA=DIGITAL_EMPLOYEE

# ── 认证 ─────────────────────────────────────────────────
# Local JWT signing secret (MUST change in production)
JWT_SECRET=change-me-in-production

# Default admin password (only used when seeding the first user on empty DB)
# ADMIN_DEFAULT_PASSWORD=changeme123

# ── Keycloak SSO (optional, leave empty to disable SSO) ───
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=de-platform
# KEYCLOAK_CLIENT_ID=de-platform
#
# Keycloak Client 配置步骤：
# 1. 创建 Realm → de-platform (或自定义名称)
# 2. 创建 Client：
#    - Client ID: de-platform
#    - Client Type: OpenID Connect
#    - Client authentication: OFF (public client, 用于 PKCE)
#    - Standard flow: ON
#    - Direct access grants: ON (用于密码登录模式)
# 3. 设置 Valid Redirect URIs:
#    - http://localhost:3000/auth/callback (开发)
#    - https://your-domain.com/auth/callback (生产)
# 4. 设置 Valid Post Logout Redirect URIs:
#    - http://localhost:3000/login (开发)
#    - https://your-domain.com/login (生产)
# 5. 设置 Web Origins:
#    - http://localhost:3000 (开发)
#    - https://your-domain.com (生产)
# 6. 在 Realm Settings → Login 中按需开启用户注册
