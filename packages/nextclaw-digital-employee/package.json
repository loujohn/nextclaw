{
  "name": "@nextclaw/digital-employee",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "preflight:deps": "pnpm -C ../nextclaw-core build && pnpm -C ../nextclaw-runtime build && pnpm -C ../extensions/nextclaw-channel-runtime build && pnpm -C ../nextclaw-openclaw-compat build",
    "dev": "pnpm preflight:deps && nuxt dev",
    "build": "pnpm preflight:deps && nuxt build",
    "lint": "eslint . --ext .ts,.vue --max-warnings=0",
    "tsc": "pnpm preflight:deps && nuxt typecheck",
    "test": "vitest run",
    "migrate:latest": "knex migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.ts",
    "migrate:make": "knex migrate:make --knexfile knexfile.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/outfit": "^5.2.6",
    "@nextclaw/core": "workspace:*",
    "@nextclaw/openclaw-compat": "workspace:*",
    "@nextclaw/runtime": "workspace:*",
    "@types/node-cron": "^3.0.11",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "https-proxy-agent": "^8.0.0",
    "knex": "^3.1.0",
    "lucide-vue-next": "^0.577.0",
    "markdown-it": "^14.1.1",
    "minipass": "^7.0.0",
    "node-cron": "^3.0.3",
    "nuxt": "^4.3.1",
    "radix-vue": "^1.9.17",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.17.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^10.8.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2",
    "vue-eslint-parser": "^10.4.0"
  }
}
